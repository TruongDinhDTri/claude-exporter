{
  "manifest_version": 3,
  "name": "Claude Exporter",
  "version": "2.0.0",
  "description": "Export Claude.ai conversations to Markdown, Text, or JSON",
  "author": "Wiganz",
  "permissions": [
    "activeTab",
    "scripting",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://claude.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Export Claude Conversation",
    "default_icon": {
      "16": "global-shipping-16.png",
      "32": "global-shipping-32.png",
      "128": "global-shipping-128.png"
    }
  },
  "icons": {
    "16": "global-shipping-16.png",
    "32": "global-shipping-32.png",
    "128": "global-shipping-128.png"
  }
}
